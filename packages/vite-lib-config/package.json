{
  "name": "@kurone-kito/vite-lib-config",
  "version": "0.22.0-alpha.9",
  "description": "The vite configuration package for the workspaces",
  "keywords": [
    "cli",
    "config",
    "vite"
  ],
  "homepage": "https://github.com/kurone-kito/builder-config#readme",
  "bugs": "https://github.com/kurone-kito/builder-config/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/kurone-kito/builder-config.git",
    "directory": "packages/vite-lib-config"
  },
  "license": "MIT",
  "author": "kurone-kito <krone@kit.black> (https://kit.black/)",
  "type": "module",
  "exports": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "docs",
    "dist"
  ],
  "scripts": {
    "build": "pnpm run \"/^build:.+/\"",
    "build:doc": "rimraf -g docs && typedoc",
    "build:vite": "vite build",
    "clean": "rimraf -g \"*.tgz\" \"*.tsbuildinfo\" coverage dist LICENSE node_modules/.cache",
    "dev": "vite build --watch",
    "prebuild": "cpy --flat ../../LICENSE .",
    "prepack": "pnpm run clean && pnpm run build",
    "test": "pnpm run \"/test:.+/\"",
    "test:ts": "tsc -p tsconfig.test.json --noEmit",
    "test:vitest": "vitest run --coverage"
  },
  "dependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "lodash-es": "^4.17.23",
    "shebang-regex": "^4.0.0",
    "type-fest": "^5.5.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "devDependencies": {
    "@kurone-kito/typescript-config": "workspace:^",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "cpy-cli": "^7.0.0",
    "rimraf": "^6.1.3",
    "typedoc": "^0.28.18",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "vite": ">=8.0.0"
  },
  "engines": {
    "node": "^20.19 || ^22 || >=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
