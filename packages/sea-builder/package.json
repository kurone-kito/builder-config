{
  "name": "@kurone-kito/sea-builder",
  "version": "0.21.0",
  "description": "The Single Executable App (SEA) builder for the Node.js",
  "keywords": [
    "sea",
    "builder",
    "boilerplate",
    "template"
  ],
  "homepage": "https://github.com/kurone-kito/builder-config#readme",
  "bugs": "https://github.com/kurone-kito/builder-config/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/kurone-kito/builder-config.git",
    "directory": "packages/sea-builder"
  },
  "license": "MIT",
  "author": "kurone-kito <krone@kit.black> (https://kit.black/)",
  "type": "module",
  "bin": {
    "sea-builder": "./dist/builder.mjs",
    "sea-cache": "./dist/cache.mjs"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "rimraf -g \"*.tgz\" \"*.tsbuildinfo\" coverage dist LICENSE node_modules/.cache",
    "dev": "vite build --watch",
    "devPreinstall": "pnpm run \"/devPreinstall:.+/\"",
    "devPreinstall:builder": "node ../../scripts/createEntryStub.mjs src/builder.mts dist/builder.mjs",
    "devPreinstall:cache": "node ../../scripts/createEntryStub.mjs src/cache.mts dist/cache.mjs",
    "prebuild": "cpy --flat ../../LICENSE .",
    "prepack": "pnpm run clean && pnpm run build",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@types/semver": "^7.8.0",
    "all-node-versions": "^13.0.1",
    "execa": "^10.0.0",
    "listr2": "^11.0.0",
    "node-releases": "^2.0.53",
    "semver": "^7.8.1"
  },
  "devDependencies": {
    "@kurone-kito/typescript-config": "workspace:^",
    "@kurone-kito/vite-lib-config": "workspace:^",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.0",
    "cpy-cli": "^7.0.0",
    "rimraf": "^6.0.1",
    "type-fest": "^5.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "xsea": "*"
  },
  "peerDependenciesMeta": {
    "xsea": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.23.2 || ^24.2.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
