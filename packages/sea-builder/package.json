{
  "name": "@kurone-kito/sea-builder",
  "version": "0.21.0",
  "description": "The Single Executable App (SEA) builder for the Node.js",
  "keywords": [
    "sea",
    "builder",
    "boilerplate",
    "template"
  ],
  "homepage": "https://github.com/kurone-kito/builder-config#readme",
  "bugs": "https://github.com/kurone-kito/builder-config/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/kurone-kito/builder-config.git",
    "directory": "packages/sea-builder"
  },
  "license": "MIT",
  "author": "kurone-kito <krone@kit.black> (https://kit.black/)",
  "type": "module",
  "bin": {
    "sea-builder": "./dist/builder.mjs",
    "sea-cache": "./dist/cache.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "rimraf -g \"*.tgz\" \"*.tsbuildinfo\" coverage dist LICENSE node_modules/.cache",
    "dev": "vite build --watch",
    "pnpm:devPreinstall": "pnpm run \"/pnpm:devPreinstall:.+/\"",
    "pnpm:devPreinstall:builder": "../../scripts/devPreInstall.mjs builder.mjs",
    "pnpm:devPreinstall:cache": "../../scripts/devPreInstall.mjs cache.mjs",
    "prebuild": "cpy --flat ../../LICENSE .",
    "prepack": "pnpm run clean && pnpm run build",
    "test": "pnpm run \"/test:.+/\"",
    "test:ts": "tsc -p tsconfig.test.json --noEmit",
    "test:vitest": "vitest run --coverage"
  },
  "dependencies": {
    "@kurone-kito/web-toybox-node": "0.1.0-alpha.11",
    "all-node-versions": "^13.0.1",
    "execa": "^9.6.1",
    "listr2": "^9.0.5",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@kurone-kito/typescript-config": "workspace:^",
    "@kurone-kito/vite-lib-config": "workspace:^",
    "@types/node": "^25.5.0",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.1.2",
    "cpy-cli": "^7.0.0",
    "rimraf": "^6.1.3",
    "type-fest": "^5.5.0",
    "typescript": "~6.0.2",
    "undici": "7.24.6",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "xsea": "*"
  },
  "peerDependenciesMeta": {
    "xsea": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.18 || ^22 || >=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
